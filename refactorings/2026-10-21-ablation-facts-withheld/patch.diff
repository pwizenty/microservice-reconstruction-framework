diff --git a/generate_certificates.sh b/generate_certificates.sh
new file mode 100755
index 0000000..c84cdf6
--- /dev/null
+++ b/generate_certificates.sh
@@ -0,0 +1,102 @@
+#!/usr/bin/env bash
+#
+# Generates the key material for the mutual TLS connections between the Lakeside
+# Mutual services. A single throwaway certificate authority signs one certificate
+# per service, and every service trusts that authority through a shared trust store.
+#
+# DEVELOPMENT ONLY. The authority's private key is created here and is trusted by
+# every service, so none of this material belongs anywhere but a developer machine.
+# The generated stores are build products: they are listed in .gitignore and must
+# never be committed.
+#
+# Usage:
+#   ./generate_certificates.sh
+#
+# The script is idempotent: it replaces the output directory on every run, which is
+# also how expired certificates are renewed.
+#
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+PASSWORD="${CERTIFICATE_PASSWORD:-changeit}"
+OUTPUT_DIRECTORY="certs"
+VALIDITY_IN_DAYS=365
+
+# Every service that terminates or initiates a mutual TLS connection. The name is
+# the file name and the certificate's common name, and it matches the service name
+# in docker-compose.yml so that the hostname check also succeeds under Docker, where
+# the services address each other by service name rather than by localhost.
+SERVICES="customer-core customer-management-backend policy-management-backend customer-self-service-backend spring-boot-admin nginx-loadbalancing"
+
+rm -rf "./$OUTPUT_DIRECTORY"
+mkdir -p "./$OUTPUT_DIRECTORY"
+
+echo "Creating the development certificate authority ..."
+keytool -genkeypair -alias ca -keyalg RSA -keysize 2048 \
+	-validity "$VALIDITY_IN_DAYS" \
+	-dname "CN=Lakeside Mutual Development CA" -ext "bc:c" \
+	-keystore "$OUTPUT_DIRECTORY/ca.p12" -storetype PKCS12 \
+	-storepass "$PASSWORD" -keypass "$PASSWORD"
+
+keytool -exportcert -alias ca -rfc \
+	-keystore "$OUTPUT_DIRECTORY/ca.p12" -storetype PKCS12 -storepass "$PASSWORD" \
+	-file "$OUTPUT_DIRECTORY/ca.crt"
+
+echo "Creating the shared trust store ..."
+keytool -importcert -noprompt -alias ca -file "$OUTPUT_DIRECTORY/ca.crt" \
+	-keystore "$OUTPUT_DIRECTORY/truststore.p12" -storetype PKCS12 \
+	-storepass "$PASSWORD"
+
+for service in $SERVICES; do
+	echo "Creating the certificate for $service ..."
+
+	# The hostname check reads the subject alternative names, not the common name.
+	subject_alternative_names="san=dns:$service,dns:localhost,ip:127.0.0.1"
+
+	keytool -genkeypair -alias "$service" -keyalg RSA -keysize 2048 \
+		-validity "$VALIDITY_IN_DAYS" \
+		-dname "CN=$service" -ext "$subject_alternative_names" \
+		-keystore "$OUTPUT_DIRECTORY/$service.p12" -storetype PKCS12 \
+		-storepass "$PASSWORD" -keypass "$PASSWORD"
+
+	keytool -certreq -alias "$service" \
+		-keystore "$OUTPUT_DIRECTORY/$service.p12" -storetype PKCS12 \
+		-storepass "$PASSWORD" \
+		-file "$OUTPUT_DIRECTORY/$service.csr"
+
+	# Both key usages are needed: the services authenticate each other, so the same
+	# certificate is presented as a server certificate and as a client certificate.
+	keytool -gencert -alias ca -infile "$OUTPUT_DIRECTORY/$service.csr" \
+		-validity "$VALIDITY_IN_DAYS" \
+		-ext "$subject_alternative_names" -ext "eku=serverAuth,clientAuth" \
+		-keystore "$OUTPUT_DIRECTORY/ca.p12" -storetype PKCS12 -storepass "$PASSWORD" \
+		-rfc -outfile "$OUTPUT_DIRECTORY/$service.crt"
+
+	# The signed certificate is only accepted as a reply to the key entry once the
+	# signing authority is itself a trusted entry of the same store.
+	keytool -importcert -noprompt -alias ca -file "$OUTPUT_DIRECTORY/ca.crt" \
+		-keystore "$OUTPUT_DIRECTORY/$service.p12" -storetype PKCS12 \
+		-storepass "$PASSWORD"
+	keytool -importcert -noprompt -alias "$service" \
+		-file "$OUTPUT_DIRECTORY/$service.crt" \
+		-keystore "$OUTPUT_DIRECTORY/$service.p12" -storetype PKCS12 \
+		-storepass "$PASSWORD"
+
+	rm "$OUTPUT_DIRECTORY/$service.csr"
+done
+
+# PEM copies of the material, for the openssl handshake check described in the
+# README and for any client that cannot read a PKCS#12 store.
+for service in $SERVICES; do
+	openssl pkcs12 -in "$OUTPUT_DIRECTORY/$service.p12" -passin "pass:$PASSWORD" \
+		-clcerts -nokeys -out "$OUTPUT_DIRECTORY/$service.pem"
+	openssl pkcs12 -in "$OUTPUT_DIRECTORY/$service.p12" -passin "pass:$PASSWORD" \
+		-nocerts -nodes -out "$OUTPUT_DIRECTORY/$service.key"
+done
+
+echo
+echo "Wrote the development key material to ./$OUTPUT_DIRECTORY:"
+ls -1 "$OUTPUT_DIRECTORY"
+echo
+echo "Store password: $PASSWORD (override with the CERTIFICATE_PASSWORD variable)."
