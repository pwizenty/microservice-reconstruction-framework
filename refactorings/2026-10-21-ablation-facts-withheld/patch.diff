diff --git a/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MutualTlsInstanceWebClientConfiguration.java b/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MutualTlsInstanceWebClientConfiguration.java
new file mode 100644
index 0000000..109bd03
--- /dev/null
+++ b/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MutualTlsInstanceWebClientConfiguration.java
@@ -0,0 +1,92 @@
+package com.lakesidemutual.springbootadmin;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.TrustManagerFactory;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Lazy;
+import org.springframework.core.io.Resource;
+import org.springframework.http.client.reactive.ReactorClientHttpConnector;
+import org.springframework.web.reactive.function.client.WebClient;
+
+import de.codecentric.boot.admin.server.web.client.InstanceWebClientCustomizer;
+import reactor.netty.http.Http11SslContextSpec;
+import reactor.netty.http.client.HttpClient;
+
+/**
+ * The Customer Core serves its endpoints over mutual TLS, so the Admin Server has to
+ * present a client certificate of its own when it polls a registered instance for
+ * health and metrics. The key store provides that certificate and the trust store the
+ * certificate authority that signed the instances' server certificates; hostname and
+ * certificate verification stay on the defaults.
+ *
+ * The stores are development material written by generate_certificates.sh in the
+ * repository root and are not part of the repository, so they are read lazily, when
+ * the first instance is polled.
+ */
+@Configuration
+public class MutualTlsInstanceWebClientConfiguration {
+	@Value("${instances.tls.keyStore}")
+	private Resource keyStore;
+
+	@Value("${instances.tls.keyStorePassword}")
+	private String keyStorePassword;
+
+	@Value("${instances.tls.trustStore}")
+	private Resource trustStore;
+
+	@Value("${instances.tls.trustStorePassword}")
+	private String trustStorePassword;
+
+	@Bean
+	@Lazy
+	public InstanceWebClientCustomizer mutualTlsInstanceWebClientCustomizer() {
+		HttpClient httpClient = HttpClient.create().secure(spec -> spec.sslContext(
+				Http11SslContextSpec.forClient().configure(sslContextBuilder -> sslContextBuilder
+						.keyManager(createKeyManagerFactory())
+						.trustManager(createTrustManagerFactory()))));
+		WebClient.Builder webClientBuilder = WebClient.builder()
+				.clientConnector(new ReactorClientHttpConnector(httpClient));
+		return instanceWebClientBuilder -> instanceWebClientBuilder.webClient(webClientBuilder);
+	}
+
+	private KeyManagerFactory createKeyManagerFactory() {
+		try {
+			KeyManagerFactory keyManagerFactory = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+			keyManagerFactory.init(loadKeyStore(keyStore, keyStorePassword), keyStorePassword.toCharArray());
+			return keyManagerFactory;
+		} catch (GeneralSecurityException | IOException e) {
+			throw new IllegalStateException(failureMessage(), e);
+		}
+	}
+
+	private TrustManagerFactory createTrustManagerFactory() {
+		try {
+			TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+			trustManagerFactory.init(loadKeyStore(trustStore, trustStorePassword));
+			return trustManagerFactory;
+		} catch (GeneralSecurityException | IOException e) {
+			throw new IllegalStateException(failureMessage(), e);
+		}
+	}
+
+	private static KeyStore loadKeyStore(Resource resource, String password) throws GeneralSecurityException, IOException {
+		KeyStore keyStore = KeyStore.getInstance("PKCS12");
+		try (InputStream inputStream = resource.getInputStream()) {
+			keyStore.load(inputStream, password.toCharArray());
+		}
+		return keyStore;
+	}
+
+	private static String failureMessage() {
+		return "Failed to set up the mutual TLS connection to the monitored instances. "
+				+ "Run ./generate_certificates.sh in the repository root to create the development key material.";
+	}
+}
