diff --git a/generate-certificates.sh b/generate-certificates.sh
new file mode 100644
index 0000000..ba3e574
--- /dev/null
+++ b/generate-certificates.sh
@@ -0,0 +1,140 @@
+#!/usr/bin/env bash
+#
+# Generates throwaway certificates for mutual TLS between the Lakeside Mutual
+# services.
+#
+# DEVELOPMENT ONLY. The CA private key is created right here and is trusted by
+# every service, so anybody who can read this directory can mint a certificate
+# that every service accepts. Never use the output of this script anywhere but
+# on a development machine.
+#
+# The output is a build product and is excluded from version control (see
+# .gitignore). Run the script once before starting the services:
+#
+#   ./generate-certificates.sh
+#
+# It is idempotent: a second run reuses the existing CA and only regenerates
+# what is missing. Pass --force to throw everything away and start over.
+#
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+PASS=changeit
+OUT=certs
+VALIDITY=365
+
+# The Customer Core is the TLS server; the other three are its clients. Each
+# name is both a Docker Compose service name and the directory the service is
+# started from, which is why the certificates are issued for it.
+SERVICES="customer-core customer-management-backend customer-self-service-backend policy-management-backend"
+
+if [ "${1:-}" = "--force" ]; then
+    echo "--force given, removing previously generated material"
+    rm -rf "$OUT"
+    for service in $SERVICES; do
+        rm -rf "$service/certs"
+    done
+fi
+
+mkdir -p "$OUT"
+
+# One CA for the whole system.
+if [ ! -f "$OUT/ca.p12" ]; then
+    echo "Creating the development CA"
+    keytool -genkeypair -alias ca -keyalg RSA -keysize 2048 -validity "$VALIDITY" \
+        -dname "CN=Lakeside Mutual Development CA, OU=Lakeside Mutual, O=Lakeside Mutual" \
+        -ext "bc:c=ca:true,pathlen:0" -ext "ku:c=keyCertSign,cRLSign" \
+        -keystore "$OUT/ca.p12" -storetype PKCS12 \
+        -storepass "$PASS" -keypass "$PASS"
+
+    keytool -exportcert -alias ca -rfc \
+        -keystore "$OUT/ca.p12" -storetype PKCS12 -storepass "$PASS" \
+        -file "$OUT/ca.crt"
+fi
+
+# A single trust store, holding only the CA certificate. Every peer uses it to
+# verify every other peer, in both directions: the server verifies the client
+# certificate with it just as the client verifies the server certificate.
+if [ ! -f "$OUT/truststore.p12" ]; then
+    echo "Creating the shared trust store"
+    keytool -importcert -noprompt -alias ca -file "$OUT/ca.crt" \
+        -keystore "$OUT/truststore.p12" -storetype PKCS12 -storepass "$PASS"
+fi
+
+for service in $SERVICES; do
+    if [ ! -f "$OUT/$service.p12" ]; then
+        echo "Creating the key store for $service"
+
+        # The subject alternative names have to cover every address a peer may
+        # use: the Docker Compose service name, and localhost when the services
+        # are started individually on the developer's machine.
+        san="dns:$service,dns:localhost,ip:127.0.0.1"
+
+        keytool -genkeypair -alias "$service" -keyalg RSA -keysize 2048 \
+            -validity "$VALIDITY" \
+            -dname "CN=$service, OU=Lakeside Mutual, O=Lakeside Mutual" \
+            -ext "san=$san" \
+            -keystore "$OUT/$service.p12" -storetype PKCS12 \
+            -storepass "$PASS" -keypass "$PASS"
+
+        keytool -certreq -alias "$service" \
+            -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS" \
+            -file "$OUT/$service.csr"
+
+        # Sign with the CA. Both extendedKeyUsage bits are set because every
+        # certificate is used in both roles: the Customer Core is a server to
+        # its three callers and a client to the Spring Boot Admin server, and
+        # the callers present their certificates as clients.
+        keytool -gencert -alias ca -infile "$OUT/$service.csr" \
+            -ext "san=$san" \
+            -ext "eku=serverAuth,clientAuth" \
+            -validity "$VALIDITY" \
+            -keystore "$OUT/ca.p12" -storetype PKCS12 -storepass "$PASS" \
+            -rfc -outfile "$OUT/$service.crt"
+
+        # The CA certificate has to be in the key store before the signed reply
+        # can be imported, otherwise keytool cannot build the chain.
+        keytool -importcert -noprompt -alias ca -file "$OUT/ca.crt" \
+            -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS"
+        keytool -importcert -noprompt -alias "$service" -file "$OUT/$service.crt" \
+            -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS"
+
+        rm -f "$OUT/$service.csr"
+    fi
+
+    # Each service reads its stores from ./certs relative to its own working
+    # directory, which is the service directory both for "mvn spring-boot:run"
+    # and for the run_all_applications scripts.
+    mkdir -p "$service/certs"
+    cp "$OUT/$service.p12" "$service/certs/$service.p12"
+    cp "$OUT/truststore.p12" "$service/certs/truststore.p12"
+    cp "$OUT/ca.crt" "$service/certs/ca.crt"
+done
+
+# PEM copies of the Customer Core's own material, for checking the handshake
+# with "openssl s_client" without having to unpack a PKCS#12 store first.
+if command -v openssl >/dev/null 2>&1; then
+    for service in $SERVICES; do
+        if [ ! -f "$OUT/$service.key" ]; then
+            openssl pkcs12 -in "$OUT/$service.p12" -passin "pass:$PASS" \
+                -nocerts -nodes -out "$OUT/$service.key" >/dev/null 2>&1
+            openssl pkcs12 -in "$OUT/$service.p12" -passin "pass:$PASS" \
+                -clcerts -nokeys -out "$OUT/$service.crt.pem" >/dev/null 2>&1
+        fi
+    done
+fi
+
+echo
+echo "Done. Generated material is in ./$OUT and copied into each service's"
+echo "certs/ directory. The store password is '$PASS'."
+echo
+echo "To check that mutual TLS actually handshakes once the Customer Core runs:"
+echo
+echo "  openssl s_client -connect localhost:8110 \\"
+echo "      -cert $OUT/policy-management-backend.crt.pem \\"
+echo "      -key $OUT/policy-management-backend.key \\"
+echo "      -CAfile $OUT/ca.crt"
+echo
+echo "Mutual TLS works when the server asks for a certificate, accepts the one"
+echo "presented, and the handshake ends with 'Verify return code: 0'."
