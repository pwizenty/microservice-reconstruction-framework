--- a/customer-management-backend/src/main/java/com/lakesidemutual/customermanagement/infrastructure/CustomerCoreClientConfiguration.java
+++ b/customer-management-backend/src/main/java/com/lakesidemutual/customermanagement/infrastructure/CustomerCoreClientConfiguration.java
@@ -1,20 +1,90 @@
 package com.lakesidemutual.customermanagement.infrastructure;
 
+import java.io.InputStream;
+import java.security.KeyStore;
 import java.util.Arrays;
 import java.util.Collection;
 
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.TrustManagerFactory;
+
+import org.springframework.beans.factory.annotation.Value;
 import org.springframework.context.annotation.Bean;
 import org.springframework.context.annotation.Configuration;
+import org.springframework.core.io.Resource;
 
+import feign.Client;
 import feign.RequestInterceptor;
 
 /**
  * The CustomerCoreClientConfiguration class configures the request interceptors for the CustomerCoreClient.
+ *
+ * It also supplies the Feign client itself, because the Customer Core serves its
+ * API over mutual TLS and rejects callers that do not present a certificate.
+ * The client is therefore built from two stores: the key store holds this
+ * service's own certificate and private key, the trust store holds the CA that
+ * signed the Customer Core's certificate. Both are generated by
+ * ./generate-certificates.sh in the repository root.
  * */
 @Configuration
 public class CustomerCoreClientConfiguration {
+	@Value("${customercore.tls.keyStore}")
+	private Resource keyStore;
+
+	@Value("${customercore.tls.keyStorePassword}")
+	private String keyStorePassword;
+
+	@Value("${customercore.tls.keyStoreType:PKCS12}")
+	private String keyStoreType;
+
+	@Value("${customercore.tls.trustStore}")
+	private Resource trustStore;
+
+	@Value("${customercore.tls.trustStorePassword}")
+	private String trustStorePassword;
+
+	@Value("${customercore.tls.trustStoreType:PKCS12}")
+	private String trustStoreType;
+
 	@Bean
 	public Collection<RequestInterceptor> interceptors() {
 		return Arrays.asList(new APIKeyRequestInterceptor());
 	}
+
+	@Bean
+	public Client feignClient() throws Exception {
+		/*
+		 * The JDK's default hostname verifier is passed deliberately: it is the
+		 * strict one, and handing it to Feign keeps HttpsURLConnection's own
+		 * hostname check in place instead of replacing it with something more
+		 * permissive.
+		 */
+		return new Client.Default(mutualTlsContext().getSocketFactory(),
+				HttpsURLConnection.getDefaultHostnameVerifier());
+	}
+
+	private SSLContext mutualTlsContext() throws Exception {
+		KeyManagerFactory keyManagerFactory = KeyManagerFactory.getInstance(
+				KeyManagerFactory.getDefaultAlgorithm());
+		keyManagerFactory.init(load(keyStore, keyStoreType, keyStorePassword),
+				keyStorePassword.toCharArray());
+
+		TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(
+				TrustManagerFactory.getDefaultAlgorithm());
+		trustManagerFactory.init(load(trustStore, trustStoreType, trustStorePassword));
+
+		SSLContext sslContext = SSLContext.getInstance("TLS");
+		sslContext.init(keyManagerFactory.getKeyManagers(), trustManagerFactory.getTrustManagers(), null);
+		return sslContext;
+	}
+
+	private static KeyStore load(Resource resource, String type, String password) throws Exception {
+		KeyStore store = KeyStore.getInstance(type);
+		try (InputStream inputStream = resource.getInputStream()) {
+			store.load(inputStream, password.toCharArray());
+		}
+		return store;
+	}
 }
