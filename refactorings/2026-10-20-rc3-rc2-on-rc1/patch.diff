+# above cannot serve as one: 0.0.0.0 is not a destination, and needClientAuth
+# is a server-side transport option. Until now this service relied on
+# ActiveMQConnectionFactory's plaintext default, which no longer connects.
+policymanagement.brokerURL=ssl://localhost:61616
