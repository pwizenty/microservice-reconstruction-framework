+/**
+ * The MessagingConfiguration class configures this service's connection to the ActiveMQ broker
+ * that the Policy Management Backend hosts. It produces to the insurance-quote-request and
+ * customer-decision queues and consumes from the insurance-quote-response,
+ * insurance-quote-expired and policy-created queues.
+ *
+ * The broker speaks TLS and demands a client certificate, so the connection is built from two
+ * stores: the key store holds this service's certificate and private key, the trust store holds
+ * the development CA that signed the broker's certificate. Both are generated by
+ * ./generate-certificates.sh in the repository root.
+ */
 @Configuration
 public class MessagingConfiguration {
 	@Value("${policymanagement.tcpBrokerBindAddress}")
@@ -28,18 +40,48 @@ public class MessagingConfiguration {
 	@Value("${spring.activemq.password}")
 	private String password;
 
+	@Value("${activemq.tls.keyStore}")
+	private String keyStore;
+
+	@Value("${activemq.tls.keyStorePassword}")
+	private String keyStorePassword;
+
+	@Value("${activemq.tls.keyStoreType:PKCS12}")
+	private String keyStoreType;
+
+	@Value("${activemq.tls.trustStore}")
+	private String trustStore;
+
+	@Value("${activemq.tls.trustStorePassword}")
+	private String trustStorePassword;
+
+	@Value("${activemq.tls.trustStoreType:PKCS12}")
+	private String trustStoreType;
+
 	@Bean
-	public JmsTemplate jmsTemplate(){
+	public JmsTemplate jmsTemplate() throws Exception {
 		JmsTemplate template = new JmsTemplate();
 		template.setMessageConverter(jacksonJmsMessageConverter());
 		template.setConnectionFactory(connectionFactory());
 		return template;
 	}
 
+	/**
+	 * The stores are handed to ActiveMQ as locations rather than as already-loaded key and
+	 * trust managers, because ActiveMQ reads them when a connection is first opened. That keeps
+	 * this bean constructible in the sliced Spring tests, which never reach the broker and so
+	 * have no key material of their own.
+	 */
 	@Bean
-	public ActiveMQConnectionFactory connectionFactory(){
-		ActiveMQConnectionFactory connectionFactory = new ActiveMQConnectionFactory();
+	public ActiveMQConnectionFactory connectionFactory() throws Exception {
+		ActiveMQSslConnectionFactory connectionFactory = new ActiveMQSslConnectionFactory();
 		connectionFactory.setBrokerURL(brokerURL);
+		connectionFactory.setKeyStore(keyStore);
+		connectionFactory.setKeyStorePassword(keyStorePassword);
+		connectionFactory.setKeyStoreType(keyStoreType);
+		connectionFactory.setTrustStore(trustStore);
+		connectionFactory.setTrustStorePassword(trustStorePassword);
+		connectionFactory.setTrustStoreType(trustStoreType);
 		connectionFactory.setUserName(username);
 		connectionFactory.setPassword(password);
 		connectionFactory.setTrustAllPackages(true);
@@ -61,7 +103,7 @@ public class MessagingConfiguration {
