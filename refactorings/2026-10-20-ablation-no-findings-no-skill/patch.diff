index 0000000..ba675f4
--- /dev/null
+++ b/scripts/generate-certificates.sh
@@ -0,0 +1,222 @@
+#!/usr/bin/env bash
+#
+# Generates the key material that the Lakeside Mutual services use for mutual
+# TLS (mTLS) on their service-to-service channels.
+#
+# The script creates a private certificate authority ("Lakeside Mutual Internal
+# CA") and one key pair per service. Every service certificate is usable both as
+# a server and as a client certificate, because most services act in both roles:
+# the Policy Management backend, for example, is a client of the Customer Core
+# and at the same time the server of the ActiveMQ message broker.
+#
+# None of the generated files are checked into version control (see .gitignore).
+# Run this script once before you start the applications for the first time:
+#
+#   ./scripts/generate-certificates.sh
+#
+# Requirements: openssl and keytool (keytool ships with every JDK).
+#
+# The material is written into the place where each application expects it:
+#
+#   <java service>/src/main/resources/certs/keystore.p12    PKCS#12 keystore
+#   <java service>/src/main/resources/certs/truststore.p12  PKCS#12 truststore
+#   <node service>/certs/{service.key,service.crt,ca.crt}   PEM files
+#
+# The Java services pick the material up from the classpath, so it is packaged
+# into the application JAR and therefore also available inside the Docker images
+# without any further configuration.
+#
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+CA_DIR="${ROOT_DIR}/certs"
+
+# The keystore password is deliberately a well-known value in this sample
+# application. In a real deployment it would be injected by the container or
+# read from a secret store instead (just like the API keys in the
+# application.properties files).
+STORE_PASSWORD="changeit"
+
+# Validity of the generated certificates, in days.
+CA_DAYS=3650
+LEAF_DAYS=825
+
+# The Java services read their key material from the classpath, the Node.js
+# services from a plain directory next to their sources.
+JAVA_SERVICES=(
+  "customer-core"
+  "customer-management-backend"
+  "customer-self-service-backend"
+  "policy-management-backend"
+)
+NODE_SERVICES=(
+  "risk-management-server"
+  "risk-management-client"
+)
+# Other clients that need PEM material in a directory of their own. The nginx of the
+# Customer Core's load balancing demo is a client of the Customer Core, so it has to
+# present a certificate as well.
+PEM_CLIENTS=(
+  "nginx-loadbalancing:customer-core/nginx-loadbalancing/nginx/certs"
+)
+
+log() {
+  echo "==> $*"
+}
+
+require() {
+  if ! command -v "$1" > /dev/null 2>&1; then
+    echo "Error: '$1' is required but was not found on the PATH." >&2
+    exit 1
+  fi
+}
+
+require openssl
+require keytool
+
+rm -rf "${CA_DIR}"
+mkdir -p "${CA_DIR}"
+
+log "Creating the Lakeside Mutual Internal CA"
+cat > "${CA_DIR}/ca.cnf" <<'EOF'
+[req]
+distinguished_name = dn
+prompt             = no
+x509_extensions    = ca_ext
+
+[dn]
+O  = Lakeside Mutual
+CN = Lakeside Mutual Internal CA
+
+[ca_ext]
+basicConstraints = critical,CA:TRUE,pathlen:0
+keyUsage         = critical,keyCertSign,cRLSign
+EOF
+
+openssl req -x509 -newkey rsa:2048 -sha256 -nodes \
+  -days "${CA_DAYS}" \
+  -config "${CA_DIR}/ca.cnf" \
+  -extensions ca_ext \
+  -keyout "${CA_DIR}/ca.key" \
+  -out "${CA_DIR}/ca.crt" 2> /dev/null
+
+# create_certificate <service-name>
+#
+# Issues a key pair for a single service. The certificate carries the service's
+# docker-compose hostname as well as localhost / 127.0.0.1 as subject
+# alternative names, so that hostname verification succeeds both when the
+# applications run inside Docker and when they are started individually on a
+# developer machine.
+create_certificate() {
+  local service="$1"
+  local dir="${CA_DIR}/${service}"
+  mkdir -p "${dir}"
+
+  cat > "${dir}/leaf.cnf" <<EOF
+[req]
+distinguished_name = dn
+prompt             = no
+
+[dn]
+O  = Lakeside Mutual
+CN = ${service}
+
+[leaf_ext]
+basicConstraints = critical,CA:FALSE
+keyUsage         = critical,digitalSignature,keyEncipherment
+extendedKeyUsage = serverAuth,clientAuth
+subjectAltName   = DNS:${service},DNS:localhost,IP:127.0.0.1
+EOF
+
+  openssl req -newkey rsa:2048 -sha256 -nodes \
+    -config "${dir}/leaf.cnf" \
+    -keyout "${dir}/${service}.key" \
+    -out "${dir}/${service}.csr" 2> /dev/null
+
+  openssl x509 -req -sha256 \
+    -days "${LEAF_DAYS}" \
+    -in "${dir}/${service}.csr" \
+    -CA "${CA_DIR}/ca.crt" \
+    -CAkey "${CA_DIR}/ca.key" \
+    -CAcreateserial \
+    -extfile "${dir}/leaf.cnf" \
+    -extensions leaf_ext \
+    -out "${dir}/${service}.crt" 2> /dev/null
+}
+
+# install_java_material <service-name>
+#
+# Packages the service's key pair into a PKCS#12 keystore and the CA
+# certificate into a PKCS#12 truststore, and places both on the service's
+# classpath.
+install_java_material() {
+  local service="$1"
+  local dir="${CA_DIR}/${service}"
+  local target="${ROOT_DIR}/${service}/src/main/resources/certs"
+
+  mkdir -p "${target}"
+  rm -f "${target}/keystore.p12" "${target}/truststore.p12"
+
+  openssl pkcs12 -export \
+    -inkey "${dir}/${service}.key" \
+    -in "${dir}/${service}.crt" \
+    -certfile "${CA_DIR}/ca.crt" \
+    -name "${service}" \
+    -out "${target}/keystore.p12" \
+    -passout "pass:${STORE_PASSWORD}"
+
+  keytool -importcert -noprompt \
+    -alias lakesidemutual-ca \
+    -file "${CA_DIR}/ca.crt" \
+    -keystore "${target}/truststore.p12" \
+    -storetype PKCS12 \
+    -storepass "${STORE_PASSWORD}" > /dev/null 2>&1
+}
+
+# install_pem_material <service-name> <target-directory>
+#
+# Copies the service's key pair and the CA certificate as PEM files into the given
+# directory, relative to the repository root.
+install_pem_material() {
+  local service="$1"
+  local dir="${CA_DIR}/${service}"
+  local target="${ROOT_DIR}/$2"
+
+  mkdir -p "${target}"
+  cp "${dir}/${service}.key" "${target}/service.key"
+  cp "${dir}/${service}.crt" "${target}/service.crt"
+  cp "${CA_DIR}/ca.crt" "${target}/ca.crt"
+}
+
+for service in "${JAVA_SERVICES[@]}"; do
+  log "Issuing a certificate for ${service}"
+  create_certificate "${service}"
+  install_java_material "${service}"
+done
+
+for service in "${NODE_SERVICES[@]}"; do
+  log "Issuing a certificate for ${service}"
+  create_certificate "${service}"
+  install_pem_material "${service}" "${service}/certs"
+done
+
+for client in "${PEM_CLIENTS[@]}"; do
+  service="${client%%:*}"
+  target="${client#*:}"
+  log "Issuing a certificate for ${service}"
+  create_certificate "${service}"
+  install_pem_material "${service}" "${target}"
+done
+
+log "Done. The CA certificate and key are in ${CA_DIR}."
+echo
+echo "The Customer Core now requires a client certificate on https://localhost:8110."
+echo "To call it by hand, use the CA and one of the client certificates, e.g.:"
+echo
+echo "  curl --cacert certs/ca.crt \\"
+echo "       --cert certs/customer-management-backend/customer-management-backend.crt \\"
+echo "       --key certs/customer-management-backend/customer-management-backend.key \\"
+echo "       -H 'Authorization: Bearer b318ad736c6c844b' \\"
+echo "       https://localhost:8110/customers"
+echo
