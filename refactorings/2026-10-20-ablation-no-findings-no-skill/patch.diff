+package com.lakesidemutual.customermanagement.infrastructure;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+
+import javax.net.ssl.KeyManager;
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.TrustManagerFactory;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.core.io.Resource;
+import org.springframework.stereotype.Component;
+
+/**
+ * MutualTlsContext loads this service's own certificate and the certificate of the
+ * Lakeside Mutual Internal CA from the classpath. The outbound channels of this service
+ * use the resulting JSSE objects to authenticate themselves to the services they call
+ * and to verify that they are in turn talking to a genuine Lakeside Mutual service.
+ *
+ * The key material is generated by scripts/generate-certificates.sh and is deliberately
+ * not part of the repository. Loading happens on demand rather than in the constructor,
+ * so that the key material is only required by those components that actually open a
+ * remote connection.
+ */
+@Component
+public class MutualTlsContext {
+	@Value("${mutualTls.keyStore}")
+	private String keyStoreLocation;
+
+	@Value("${mutualTls.keyStorePassword}")
+	private String keyStorePassword;
+
+	@Value("${mutualTls.trustStore}")
+	private String trustStoreLocation;
+
+	@Value("${mutualTls.trustStorePassword}")
+	private String trustStorePassword;
+
+	public KeyManager[] getKeyManagers() {
+		try {
+			KeyManagerFactory keyManagerFactory = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+			keyManagerFactory.init(load(keyStoreLocation, keyStorePassword), keyStorePassword.toCharArray());
+			return keyManagerFactory.getKeyManagers();
+		} catch (GeneralSecurityException | IOException e) {
+			throw new IllegalStateException(missingKeyMaterialMessage(keyStoreLocation), e);
+		}
+	}
+
+	public TrustManager[] getTrustManagers() {
+		try {
+			TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+			trustManagerFactory.init(load(trustStoreLocation, trustStorePassword));
+			return trustManagerFactory.getTrustManagers();
+		} catch (GeneralSecurityException | IOException e) {
+			throw new IllegalStateException(missingKeyMaterialMessage(trustStoreLocation), e);
+		}
+	}
+
+	/**
+	 * Returns an SSLContext that presents this service's certificate to its peer and
+	 * trusts only certificates issued by the Lakeside Mutual Internal CA.
+	 */
+	public SSLContext createSslContext() {
+		try {
+			SSLContext sslContext = SSLContext.getInstance("TLS");
+			sslContext.init(getKeyManagers(), getTrustManagers(), null);
+			return sslContext;
+		} catch (GeneralSecurityException e) {
+			throw new IllegalStateException("Failed to set up the mutual TLS context.", e);
+		}
+	}
+
+	private static KeyStore load(String location, String password) throws GeneralSecurityException, IOException {
+		KeyStore keyStore = KeyStore.getInstance("PKCS12");
+		Resource resource = new ClassPathResource(location);
+		try (InputStream inputStream = resource.getInputStream()) {
+			keyStore.load(inputStream, password.toCharArray());
+		}
+		return keyStore;
+	}
+
+	private static String missingKeyMaterialMessage(String location) {
+		return "Failed to load the mutual TLS key material from the classpath location '" + location
+				+ "'. Run scripts/generate-certificates.sh to generate it before starting the application.";
+	}
+}
