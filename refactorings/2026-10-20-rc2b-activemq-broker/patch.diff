diff --git a/generate-certificates.sh b/generate-certificates.sh
new file mode 100644
index 0000000..d0da38f
--- /dev/null
+++ b/generate-certificates.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+#
+# Generates throwaway certificates for the mutual TLS connections between the
+# Lakeside Mutual services (currently: the ActiveMQ broker hosted by the Policy
+# Management backend, its Java clients and the Node.js Risk Management server).
+#
+# DEVELOPMENT ONLY. The CA private key is created right here and is trusted by
+# every service, so anything signed with it is accepted by every peer. Never
+# use the output of this script anywhere but a developer machine, and never
+# commit it - `certs/` is in .gitignore for that reason.
+#
+# Usage:
+#   ./generate-certificates.sh
+#
+# The script is idempotent: material that already exists is left alone, so a
+# second run is a no-op. Delete the `certs/` directory to start over.
+#
+# Requires `openssl` and the JDK's `keytool` (both are already needed to build
+# and run the system).
+#
+set -euo pipefail
+
+PASS=changeit
+OUT="$(cd "$(dirname "$0")" && pwd)/certs"
+DAYS=365
+
+# Each entry is "<name>|<subjectAltName list>". The name doubles as the file
+# base name, the certificate's common name and the key store alias. The SAN
+# list has to cover every name a peer may use to address the service: the
+# docker-compose service name, the short service name used elsewhere in the
+# system, and localhost for a local run outside Docker.
+SERVICES=(
+    "policy-management-backend|DNS:policy-management-backend,DNS:policy-management,DNS:localhost,IP:127.0.0.1"
+    "customer-self-service-backend|DNS:customer-self-service-backend,DNS:customer-self-service,DNS:localhost,IP:127.0.0.1"
+    "risk-management-server|DNS:risk-management-server,DNS:risk-management,DNS:localhost,IP:127.0.0.1"
+)
+
+mkdir -p "$OUT"
+
+# One CA for the whole system.
+if [ ! -f "$OUT/ca.crt" ]; then
+    echo "Creating development CA"
+    openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days "$DAYS" \
+        -keyout "$OUT/ca.key" -out "$OUT/ca.crt" \
+        -subj "/CN=Lakeside Mutual Development CA" \
+        -addext "basicConstraints=critical,CA:TRUE" \
+        -addext "keyUsage=critical,keyCertSign,cRLSign"
+fi
+
+# One trust store, holding only the CA certificate: it is enough for every peer
+# to verify every other peer, in both directions.
+if [ ! -f "$OUT/truststore.p12" ]; then
+    echo "Creating trust store"
+    keytool -importcert -noprompt -alias ca -file "$OUT/ca.crt" \
+        -keystore "$OUT/truststore.p12" -storetype PKCS12 -storepass "$PASS"
+fi
+
+for entry in "${SERVICES[@]}"; do
+    name="${entry%%|*}"
+    sans="${entry##*|}"
+
+    if [ -f "$OUT/$name.p12" ]; then
+        echo "Keeping existing material for $name"
+        continue
+    fi
+
+    echo "Issuing certificate for $name"
+
+    openssl req -newkey rsa:2048 -nodes \
+        -keyout "$OUT/$name.key" -out "$OUT/$name.csr" \
+        -subj "/CN=$name"
+
+    # extendedKeyUsage carries both serverAuth and clientAuth, because under
+    # mutual TLS every service is a server for some connections and a client
+    # for others.
+    openssl x509 -req -in "$OUT/$name.csr" -sha256 -days "$DAYS" \
+        -CA "$OUT/ca.crt" -CAkey "$OUT/ca.key" -CAcreateserial \
+        -out "$OUT/$name.crt" \
+        -extfile <(printf 'subjectAltName=%s\nextendedKeyUsage=serverAuth,clientAuth\nkeyUsage=critical,digitalSignature,keyEncipherment\n' "$sans")
+
+    rm -f "$OUT/$name.csr"
+
+    # The Java services read a PKCS#12 key store; the Node.js service reads the
+    # PEM key and certificate written above, so both forms are kept.
+    openssl pkcs12 -export \
+        -inkey "$OUT/$name.key" -in "$OUT/$name.crt" -certfile "$OUT/ca.crt" \
+        -name "$name" -passout "pass:$PASS" -out "$OUT/$name.p12"
+done
+
+echo
+echo "Development certificates are in $OUT"
+echo "Key store password: $PASS"
