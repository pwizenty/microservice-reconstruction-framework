diff --git a/generate-certificates.sh b/generate-certificates.sh
new file mode 100755
index 0000000..7df3d8d
--- /dev/null
+++ b/generate-certificates.sh
@@ -0,0 +1,113 @@
+#!/bin/sh
+#
+# Generates the key material that the Lakeside Mutual services use to
+# authenticate each other with mutual TLS.
+#
+# Everything this script writes is development key material: it is NOT in
+# version control (see .gitignore) and it must never be used outside a
+# development machine. Run the script once before starting the applications:
+#
+#   ./generate-certificates.sh
+#
+# It creates a private certificate authority and, signed by it, one key pair per
+# service. Each certificate carries both serverAuth and clientAuth extended key
+# usages, because in a mesh of mutually authenticated services every service
+# acts in both roles. The subject alternative names cover the two ways a service
+# is addressed in this project: by its Docker Compose service name and as
+# localhost when the applications are started directly on the host.
+#
+# Output (in ./certificates, override with LAKESIDEMUTUAL_TLS_DIR):
+#
+#   ca.crt, ca.key         the private certificate authority
+#   truststore.p12         CA certificate, used as truststore by the JVM services
+#   <service>.p12          key + certificate chain, used as keystore by the JVM services
+#   <service>.key/.crt     the same identity in PEM form, used by the Node.js services
+#
+# Prerequisites: openssl and keytool (keytool ships with the JDK that the
+# backends already require). On Windows, run this script from Git Bash or WSL.
+#
+set -eu
+
+SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
+
+OUT_DIR="${LAKESIDEMUTUAL_TLS_DIR:-$SCRIPT_DIR/certificates}"
+
+# The password protects the generated PKCS#12 files. Like the API keys in the
+# application.properties files, it is hardcoded here for convenience; the
+# services read it from LAKESIDEMUTUAL_TLS_PASSWORD, so a real deployment can
+# inject a different one.
+PASSWORD="${LAKESIDEMUTUAL_TLS_PASSWORD:-lakesidemutual}"
+
+# Validity of the service certificates in days. 825 days is the maximum that
+# current TLS clients accept for a leaf certificate.
+DAYS="${LAKESIDEMUTUAL_TLS_DAYS:-825}"
+
+# Every service that terminates or initiates a mutually authenticated
+# connection needs its own identity.
+SERVICES="customer-core customer-management-backend customer-self-service-backend policy-management-backend risk-management-server risk-management-client spring-boot-admin"
+
+echo "Writing key material to $OUT_DIR"
+rm -rf "$OUT_DIR"
+mkdir -p "$OUT_DIR"
+
+echo "Creating the Lakeside Mutual certificate authority"
+openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
+  -keyout "$OUT_DIR/ca.key" \
+  -out "$OUT_DIR/ca.crt" \
+  -subj "/O=Lakeside Mutual/CN=Lakeside Mutual Internal CA" \
+  -addext "basicConstraints=critical,CA:TRUE" \
+  -addext "keyUsage=critical,keyCertSign,cRLSign" \
+  2>/dev/null
+
+for SERVICE in $SERVICES; do
+  echo "Issuing a certificate for $SERVICE"
+
+  EXT_FILE="$OUT_DIR/$SERVICE.ext"
+  cat > "$EXT_FILE" <<EXT
+basicConstraints=critical,CA:FALSE
+keyUsage=critical,digitalSignature,keyEncipherment
+extendedKeyUsage=serverAuth,clientAuth
+subjectAltName=DNS:$SERVICE,DNS:localhost,IP:127.0.0.1
+EXT
+
+  openssl req -newkey rsa:2048 -nodes \
+    -keyout "$OUT_DIR/$SERVICE.key" \
+    -out "$OUT_DIR/$SERVICE.csr" \
+    -subj "/O=Lakeside Mutual/CN=$SERVICE" \
+    2>/dev/null
+
+  openssl x509 -req -sha256 -days "$DAYS" \
+    -in "$OUT_DIR/$SERVICE.csr" \
+    -CA "$OUT_DIR/ca.crt" \
+    -CAkey "$OUT_DIR/ca.key" \
+    -CAcreateserial \
+    -extfile "$EXT_FILE" \
+    -out "$OUT_DIR/$SERVICE.crt" \
+    2>/dev/null
+
+  # The PKCS#12 file holds the private key together with the full chain, so the
+  # JVM services can present a complete chain to their peers.
+  openssl pkcs12 -export \
+    -name "$SERVICE" \
+    -inkey "$OUT_DIR/$SERVICE.key" \
+    -in "$OUT_DIR/$SERVICE.crt" \
+    -certfile "$OUT_DIR/ca.crt" \
+    -out "$OUT_DIR/$SERVICE.p12" \
+    -passout "pass:$PASSWORD"
+
+  rm -f "$OUT_DIR/$SERVICE.csr" "$EXT_FILE"
+done
+
+echo "Creating the shared truststore"
+keytool -importcert -noprompt -trustcacerts \
+  -alias lakesidemutual-ca \
+  -file "$OUT_DIR/ca.crt" \
+  -keystore "$OUT_DIR/truststore.p12" \
+  -storetype PKCS12 \
+  -storepass "$PASSWORD" \
+  > /dev/null
+
+rm -f "$OUT_DIR/ca.srl"
+chmod 600 "$OUT_DIR"/*.key "$OUT_DIR"/*.p12
+
+echo "Done. The services pick the key material up from $OUT_DIR."
diff --git a/policy-management-backend/src/main/resources/application.properties b/policy-management-backend/src/main/resources/application.properties
