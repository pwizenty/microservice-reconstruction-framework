+++ b/policy-management-backend/src/main/resources/application.properties
@@ -30,12 +30,47 @@ server.port = 8090
 management.endpoints.web.exposure.include=*
 management.info.git.mode=full
 
-# ActiveMQ settings
-policymanagement.stompBrokerBindAddress=stomp://0.0.0.0:61613
-policymanagement.tcpBrokerBindAddress=tcp://0.0.0.0:61616
+# ActiveMQ settings. Both connectors terminate TLS and require the connecting
+# service to present a certificate issued by the Lakeside Mutual CA
+# (needClientAuth). The STOMP connector is used by the Risk Management Server,
+# the OpenWire connector by the Customer Self-Service backend and by this
+# application itself.
+policymanagement.stompBrokerBindAddress=stomp+ssl://0.0.0.0:61613?transport.needClientAuth=true
+policymanagement.tcpBrokerBindAddress=ssl://0.0.0.0:61616?transport.needClientAuth=true
+
+# The URL this application itself uses to reach the broker it hosts. It is a
+# separate property because the connectors above bind to every interface, while
+# a client has to address a concrete host whose name the certificate covers.
+policymanagement.brokerURL=ssl://localhost:61616
+
 riskmanagement.queueName=newpolicies
 spring.activemq.user=queueuser
 spring.activemq.password=secret
 
-customercore.baseURL=http://localhost:8110
+# The Customer Core requires mutual TLS, so this backend talks to it over https
+# and presents its own certificate.
+customercore.baseURL=https://localhost:8110
+
+# Mutual TLS identity of this backend. It is used for the Customer Core
+# connection, for the message broker it hosts and for its own broker
+# connection. The key material is created by ../generate-certificates.sh and is
+# not in version control. Override its location with LAKESIDEMUTUAL_TLS_DIR and
+# its password with LAKESIDEMUTUAL_TLS_PASSWORD.
+lakesidemutual.tls.dir=../certificates
+lakesidemutual.tls.password=lakesidemutual
+lakesidemutual.tls.bundle=lakesidemutual
+
+spring.ssl.bundle.jks.lakesidemutual.key.alias=policy-management-backend
+spring.ssl.bundle.jks.lakesidemutual.keystore.location=file:${lakesidemutual.tls.dir}/policy-management-backend.p12
+spring.ssl.bundle.jks.lakesidemutual.keystore.password=${lakesidemutual.tls.password}
+spring.ssl.bundle.jks.lakesidemutual.keystore.type=PKCS12
+spring.ssl.bundle.jks.lakesidemutual.truststore.location=file:${lakesidemutual.tls.dir}/truststore.p12
+spring.ssl.bundle.jks.lakesidemutual.truststore.password=${lakesidemutual.tls.password}
+spring.ssl.bundle.jks.lakesidemutual.truststore.type=PKCS12
+
+# ActiveMQ is not aware of Spring's SSL bundles, so the same two stores are also
+# addressed directly for the message broker connection.
+lakesidemutual.tls.keystore=${lakesidemutual.tls.dir}/policy-management-backend.p12
+lakesidemutual.tls.truststore=${lakesidemutual.tls.dir}/truststore.p12
+
 spring.boot.admin.client.url = http://localhost:9000
