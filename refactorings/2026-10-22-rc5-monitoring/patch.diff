index 0000000..da0fd64
--- /dev/null
+++ b/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MonitoringTlsConfiguration.java
@@ -0,0 +1,115 @@
+package com.lakesidemutual.springbootadmin;
+
+import java.io.InputStream;
+import java.net.http.HttpClient;
+import java.security.KeyStore;
+
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.TrustManagerFactory;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.web.reactive.function.client.WebClientCustomizer;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.Ordered;
+import org.springframework.core.annotation.Order;
+import org.springframework.core.io.Resource;
+import org.springframework.http.client.reactive.JdkClientHttpConnector;
+
+/**
+ * Configures the HTTP client that the Spring Boot Admin server uses to poll the
+ * actuator endpoints of the applications registered with it.
+ *
+ * Monitoring is a service-to-service channel like any other: the Customer Core
+ * serves its API, actuator endpoints included, over mutual TLS and rejects
+ * callers that do not present a certificate. The monitoring server therefore
+ * needs the same two stores every other caller of the Customer Core needs: the
+ * key store holding its own certificate and private key, and the trust store
+ * holding the CA that signed the Customer Core's certificate. Both are
+ * generated by ./generate-certificates.sh in the repository root.
+ *
+ * The customizer is applied to the {@code WebClient.Builder} that Spring Boot
+ * auto-configures, which is the builder Spring Boot Admin's
+ * {@code InstanceWebClient} is built from. It runs last so that it replaces the
+ * connector set by Spring Boot's own {@code webClientHttpConnectorCustomizer}.
+ * The connector is used for every registered application, so the services that
+ * are still reached over plaintext HTTP keep working unchanged.
+ */
+@Configuration
+public class MonitoringTlsConfiguration {
+	private static final Logger LOG = LoggerFactory.getLogger(MonitoringTlsConfiguration.class);
+
+	@Value("${monitoring.tls.keyStore}")
+	private Resource keyStore;
+
+	@Value("${monitoring.tls.keyStorePassword}")
+	private String keyStorePassword;
+
+	@Value("${monitoring.tls.keyStoreType:PKCS12}")
+	private String keyStoreType;
+
+	@Value("${monitoring.tls.trustStore}")
+	private Resource trustStore;
+
+	@Value("${monitoring.tls.trustStorePassword}")
+	private String trustStorePassword;
+
+	@Value("${monitoring.tls.trustStoreType:PKCS12}")
+	private String trustStoreType;
+
+	@Bean
+	@Order(Ordered.LOWEST_PRECEDENCE)
+	public WebClientCustomizer monitoringTlsWebClientCustomizer() throws Exception {
+		if (!keyStore.exists() || !trustStore.exists()) {
+			/*
+			 * The stores are generated, not committed, so a fresh checkout does not
+			 * carry them. The monitoring server still starts and still monitors the
+			 * applications it reaches over plaintext HTTP; the ones behind mutual TLS
+			 * stay OFFLINE until the stores are there. Nothing is trusted that would
+			 * not otherwise be trusted - the client simply falls back to the JDK's
+			 * default trust material and presents no certificate.
+			 */
+			LOG.warn("No key or trust store found at {} and {}. Applications that require a client "
+					+ "certificate, such as the Customer Core, cannot be monitored. Run "
+					+ "./generate-certificates.sh in the repository root and restart.",
+					keyStore, trustStore);
+			return builder -> {
+			};
+		}
+
+		/*
+		 * The JDK's HttpClient is given the SSLContext only. It verifies the server
+		 * hostname against the certificate by default, and that default is left
+		 * alone deliberately.
+		 */
+		JdkClientHttpConnector connector = new JdkClientHttpConnector(
+				HttpClient.newBuilder().sslContext(mutualTlsContext()).build());
+		return builder -> builder.clientConnector(connector);
+	}
+
+	private SSLContext mutualTlsContext() throws Exception {
+		KeyManagerFactory keyManagerFactory = KeyManagerFactory.getInstance(
+				KeyManagerFactory.getDefaultAlgorithm());
+		keyManagerFactory.init(load(keyStore, keyStoreType, keyStorePassword),
+				keyStorePassword.toCharArray());
+
+		TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(
+				TrustManagerFactory.getDefaultAlgorithm());
+		trustManagerFactory.init(load(trustStore, trustStoreType, trustStorePassword));
+
+		SSLContext sslContext = SSLContext.getInstance("TLS");
+		sslContext.init(keyManagerFactory.getKeyManagers(), trustManagerFactory.getTrustManagers(), null);
+		return sslContext;
+	}
+
+	private static KeyStore load(Resource resource, String type, String password) throws Exception {
+		KeyStore store = KeyStore.getInstance(type);
+		try (InputStream inputStream = resource.getInputStream()) {
+			store.load(inputStream, password.toCharArray());
+		}
+		return store;
+	}
+}
