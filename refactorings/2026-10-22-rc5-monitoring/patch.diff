diff --git a/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MonitoringTlsConfiguration.java b/spring-boot-admin/src/main/java/com/lakesidemutual/springbootadmin/MonitoringTlsConfiguration.java
