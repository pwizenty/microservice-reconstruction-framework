+# The monitoring server polls the actuator endpoints of every registered
+# application. The Customer Core serves them over mutual TLS and requires a
+# client certificate, so the monitoring server presents one of its own and
+# verifies the Customer Core against the shared trust store. See
+# MonitoringTlsConfiguration; the applications still reached over plaintext
+# HTTP are unaffected.
+#
+# The stores are not in version control. Run ./generate-certificates.sh in the
+# repository root once before starting the service.
+monitoring.tls.keyStore=file:./certs/spring-boot-admin.p12
+monitoring.tls.keyStorePassword=changeit
+monitoring.tls.keyStoreType=PKCS12
+monitoring.tls.trustStore=file:./certs/truststore.p12
+monitoring.tls.trustStorePassword=changeit
+monitoring.tls.trustStoreType=PKCS12
