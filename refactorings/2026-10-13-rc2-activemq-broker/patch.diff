diff --git a/policy-management-backend/src/main/java/com/lakesidemutual/policymanagement/interfaces/configuration/MessagingSslContextFactory.java b/policy-management-backend/src/main/java/com/lakesidemutual/policymanagement/interfaces/configuration/MessagingSslContextFactory.java
new file mode 100644
index 0000000..0214da3
--- /dev/null
+++ b/policy-management-backend/src/main/java/com/lakesidemutual/policymanagement/interfaces/configuration/MessagingSslContextFactory.java
@@ -0,0 +1,39 @@
+package com.lakesidemutual.policymanagement.interfaces.configuration;
+
+import org.apache.activemq.broker.SslContext;
+
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.TrustManagerFactory;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.security.KeyStore;
+
+/**
+ * Builds the SSL context that the embedded ActiveMQ broker uses for its ssl:// and
+ * stomp+ssl:// connectors. The key store holds the broker's own certificate, the trust
+ * store the certificate authority that signed the clients' certificates - which is the
+ * other half of mutual TLS, since the connectors are configured with
+ * transport.needClientAuth=true and therefore reject anonymous clients.
+ */
+public final class MessagingSslContextFactory {
+    private MessagingSslContextFactory() {
+    }
+
+    public static SslContext create(String keyStorePath, String keyStorePassword, String trustStorePath, String trustStorePassword) throws Exception {
+        KeyManagerFactory keyManagerFactory = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+        keyManagerFactory.init(loadKeyStore(keyStorePath, keyStorePassword), keyStorePassword.toCharArray());
+
+        TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+        trustManagerFactory.init(loadKeyStore(trustStorePath, trustStorePassword));
+
+        return new SslContext(keyManagerFactory.getKeyManagers(), trustManagerFactory.getTrustManagers(), null);
+    }
+
+    private static KeyStore loadKeyStore(String path, String password) throws Exception {
+        KeyStore keyStore = KeyStore.getInstance("PKCS12");
+        try (InputStream inputStream = new FileInputStream(path)) {
+            keyStore.load(inputStream, password.toCharArray());
+        }
+        return keyStore;
+    }
+}
