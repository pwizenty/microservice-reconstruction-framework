diff --git a/generate_certificates.sh b/generate_certificates.sh
new file mode 100755
index 0000000..9a4007d
--- /dev/null
+++ b/generate_certificates.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+#
+# Generates the throwaway certificates that the services use for mutual TLS on
+# the ActiveMQ channels: the broker inside the Policy Management backend, its
+# Java clients (Policy Management backend, Customer Self-Service backend) and
+# its Node client (Risk Management server).
+#
+# DEVELOPMENT ONLY. The CA private key is created right here and is trusted by
+# every service, so anything it signs is accepted by the whole system. Never
+# use the output of this script outside a development machine, and never commit
+# it - the certs/ directory is in .gitignore.
+#
+# Usage:
+#   ./generate_certificates.sh            # generate once, keep what is there
+#   ./generate_certificates.sh --force    # throw everything away and redo it
+#
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+PASS=changeit
+OUT=certs
+
+# The certificate subjects double as host names. Each name is both the
+# docker-compose service name and the DNS name peers address each other by, so
+# host name verification holds under Docker Compose as well as on localhost.
+SERVICES="policy-management-backend customer-self-service-backend risk-management-server"
+
+if [ "${1:-}" = "--force" ]; then
+    rm -rf "$OUT"
+fi
+
+if [ -d "$OUT" ] && [ -f "$OUT/truststore.p12" ]; then
+    echo "$OUT already exists - nothing to do (use --force to regenerate)."
+    exit 0
+fi
+
+mkdir -p "$OUT"
+
+echo "==> Creating the development CA"
+keytool -genkeypair -alias ca -keyalg RSA -keysize 2048 -validity 365 \
+    -dname "CN=Lakeside Mutual Dev CA" -ext bc:c \
+    -keystore "$OUT/ca.p12" -storetype PKCS12 \
+    -storepass "$PASS" -keypass "$PASS"
+
+keytool -exportcert -alias ca -rfc \
+    -keystore "$OUT/ca.p12" -storetype PKCS12 -storepass "$PASS" \
+    -file "$OUT/ca.crt"
+
+echo "==> Creating the shared trust store"
+keytool -importcert -noprompt -alias ca -file "$OUT/ca.crt" \
+    -keystore "$OUT/truststore.p12" -storetype PKCS12 -storepass "$PASS"
+
+for service in $SERVICES; do
+    echo "==> Creating the key store for $service"
+    san="san=dns:$service,dns:localhost,ip:127.0.0.1"
+
+    keytool -genkeypair -alias "$service" -keyalg RSA -keysize 2048 \
+        -validity 365 -dname "CN=$service" -ext "$san" \
+        -keystore "$OUT/$service.p12" -storetype PKCS12 \
+        -storepass "$PASS" -keypass "$PASS"
+
+    keytool -certreq -alias "$service" \
+        -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS" \
+        -file "$OUT/$service.csr"
+
+    # Both the server and the client role are needed: every peer presents its
+    # certificate in the other direction as well.
+    keytool -gencert -alias ca -infile "$OUT/$service.csr" \
+        -ext "$san" -ext "eku=serverAuth,clientAuth" -validity 365 \
+        -keystore "$OUT/ca.p12" -storetype PKCS12 -storepass "$PASS" \
+        -rfc -outfile "$OUT/$service.crt"
+
+    # Import the CA first, so that importing the signed certificate below can
+    # build a chain and replaces the self-signed one under the key alias.
+    keytool -importcert -noprompt -alias ca -file "$OUT/ca.crt" \
+        -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS"
+    keytool -importcert -noprompt -alias "$service" -file "$OUT/$service.crt" \
+        -keystore "$OUT/$service.p12" -storetype PKCS12 -storepass "$PASS"
+
+    rm -f "$OUT/$service.csr"
+done
+
+echo "==> Exporting PEM material for the Node client (stompit wants PEM, not PKCS#12)"
+for service in risk-management-server; do
+    openssl pkcs12 -in "$OUT/$service.p12" -passin "pass:$PASS" \
+        -nocerts -nodes -out "$OUT/$service.key"
+    openssl pkcs12 -in "$OUT/$service.p12" -passin "pass:$PASS" \
+        -clcerts -nokeys -out "$OUT/$service.crt"
+    chmod 600 "$OUT/$service.key"
+done
+
+echo
+echo "Done. Development certificates are in ./$OUT:"
+ls -1 "$OUT"
